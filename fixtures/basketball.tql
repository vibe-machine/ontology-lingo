put lingoVerificationExecutesQuestion (verificationRun: $verification, executableQuestion: $executable);
put lingoVerificationRunsInBinding (verificationRun: $verification, stagingBinding: $staging);
put lingoVerificationHasResult (verificationRun: $verification, verificationResult: $verificationResult);
put lingoWorkbookHasApplyReceipt (workbook: $workbook, applyReceipt: $receipt);
put lingoApplyReceiptAppliesChangeSet (applyReceipt: $receipt, changeSet: $changeSet);
put lingoApplyReceiptAuthorizedByVerification (applyReceipt: $receipt, verificationRun: $verification);
put lingoApplyReceiptTargetsBinding (applyReceipt: $receipt, stagingBinding: $staging);
put lingoApplyReceiptHasOperationOutcome (applyReceipt: $receipt, operationOutcome: $operationOutcome);
put lingoApplyOutcomeForOperation (operationOutcome: $operationOutcome, operation: $relationOperation);

match
  $targetMatch isa LingoOntologyTargetContextRevision,
    has lingoRevisionId "fixture:basketball:target:r1";
  $gistVersion isa OntologyModuleVersion,
    has moduleVersionKey "https://github.com/semanticarts/gist@5.0.0";
put
  lingoTargetUsesModuleVersion (targetContextRevision: $targetMatch, moduleVersion: $gistVersion);

match
  $teamItemMatch isa LingoGroundingPlanItemRevision,
    has lingoRevisionId "fixture:basketball:plan-item:team:r1";
  $organizationResource isa SchemaResource,
    has typeLabel "Organization";
put
  lingoPlanItemMapsToSchemaResource (planItemRevision: $teamItemMatch, resource: $organizationResource);
