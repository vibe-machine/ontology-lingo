match
  $teamItem isa LingoGroundingPlanItemRevision,
    has lingoRevisionId "fixture:basketball:plan-item:team:r1";
  lingoHumanDecisionDecides (decision: $teamDecision, subject: $teamItem);
  $teamDecision has lingoHumanDecisionState "confirmed";
  not {
    lingoOperationRealizesPlanItem (operation: $teamOperation, planItemRevision: $teamItem);
  };
  $outcomesItem isa LingoGroundingPlanItemRevision,
    has lingoRevisionId "fixture:basketball:plan-item:outcomes:r1";
  lingoHumanDecisionDecides (decision: $outcomesDecision, subject: $outcomesItem);
  $outcomesDecision has lingoHumanDecisionState "deferred";
  not {
    lingoOperationRealizesPlanItem (operation: $outcomesOperation, planItemRevision: $outcomesItem);
  };
fetch {
  "confirmedWithoutOperationVerification": $teamItem.lingoRevisionId,
  "deferredWithoutOperation": $outcomesItem.lingoRevisionId
};
