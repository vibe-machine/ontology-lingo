match
  $workbook isa LingoStudioWorkbook,
    has lingoWorkbookId "fixture:basketball";
  lingoWorkbookCurrentBrief (workbook: $workbook, briefRevision: $brief);
  lingoBriefIncludesElementRevision (briefRevision: $brief, elementRevision: $frame);
  $frame isa LingoBriefRelationFrameRevision,
    has lingoRevisionId $frameId;
  lingoRelationFrameHasRole (frameRevision: $frame, roleRevision: $playerRole);
  lingoRelationFrameHasRole (frameRevision: $frame, roleRevision: $teamRole);
  lingoRelationFrameHasRole (frameRevision: $frame, roleRevision: $seasonRole);
  $playerRole has lingoRoleName "player";
  $teamRole has lingoRoleName "team";
  $seasonRole has lingoRoleName "season";
  lingoWorkbookCurrentPlan (workbook: $workbook, planRevision: $plan);
  lingoPlanItemInterpretsBriefElement (planItemRevision: $planItem, briefElementRevision: $frame);
  lingoOperationRealizesPlanItem (operation: $operation, planItemRevision: $planItem);
  lingoChangeSetContainsOperation (changeSet: $changeSet, operation: $operation);
  lingoExecutableCompiledForChangeSet (executableQuestion: $executable, changeSet: $changeSet);
  lingoVerificationExecutesQuestion (verificationRun: $verification, executableQuestion: $executable);
  lingoApplyReceiptAuthorizedByVerification (applyReceipt: $receipt, verificationRun: $verification);
  $plan has lingoRevisionId $planId;
  $operation has lingoChangeOperationId $operationId;
  $executable has lingoExecutableCqId $executableId;
  $verification has lingoVerificationRunId $verificationId;
  $receipt has lingoApplyReceiptId $receiptId;
fetch {
  "canonicalFrame": $frameId,
  "plan": $planId,
  "operation": $operationId,
  "executableCQ": $executableId,
  "verification": $verificationId,
  "receipt": $receiptId
};
