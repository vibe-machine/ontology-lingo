# 21. Which concepts rest on a single source?
match
  $brief isa ModelingBrief, has briefId "pom";
  let $revision = current_revision($brief);
  $c isa BriefConcept, has name $concept;
  inclusion (revision: $revision, element: $c);
  grounding (element: $c, groundingClaim: $claim);
  support (supportedClaim: $claim, evidence: $p); placement (passage: $p, passageSource: $s);
select $concept, $s;
distinct;
reduce $sources = count groupby $concept;
match $sources == 1;
select $concept;
