# Generated executable apply unit from migrations/v1.0.2-to-v1.1.1/0001.tql
# manifest: manifests/lingo-v1.1.1.package-manifest.json

put $query1 isa StoredQuery, has storedQueryName "lingo/readings-for-a-subject";
update $query1 has storedQueryTitle "Readings for a subject";
  $query1 has storedQueryText "match\n  $brief isa ModelingBrief, has briefId \"pom\", has name $subject;\n  readingPurpose (purposefulReading: $r, purposeBrief: $brief);\n  $r has readingId $reading, has atDateTime $when, has formatVersion $briefVersion;\n  readingSubject (pass: $r, sourceRead: $s); $s has name $source;\n  readership (reading: $r, reader: $who);\n  try { $who has name $reader; };\nselect $subject, $source, $reading, $reader, $when, $briefVersion;";
  $query1 has storedPackage "lingo";
  $query1 has storedVersion "1.1.0";
  $query1 has storedQueryExplanation "Finds the readings done for one subject's brief (here the product operating model) and shows the source read, who read it, when, and which version of the reading brief they followed.";

put $query4 isa StoredQuery, has storedQueryName "lingo/what-one-source-says-about-one-term";
update $query4 has storedQueryTitle "What one source says about one term";
  $query4 has storedQueryText "match\n  $s isa EvidenceSource, has sourceId \"cagan-transformed-2024\";\n  vocabulary (term: $t, termSource: $s); $t has name \"outcome\";\n  aboutness (claim: $c, term: $t);\n  $c isa! $kind, has claimId $claim, has containedText $text;\nselect $claim, $kind, $text;";
  $query4 has storedPackage "lingo";
  $query4 has storedVersion "1.1.0";
  $query4 has storedQueryExplanation "Takes one source (Transformed) and one of its terms (outcome) and lists every claim about that term, with the kind of claim it is.";

put $query12 isa StoredQuery, has storedQueryName "lingo/terms-the-reader-had-to-name";
update $query12 has storedQueryTitle "Terms the reader had to name";
  $query12 has storedQueryText "match\n  $t isa SourceTerm, has name $term, has termIsReaders true;\n  vocabulary (term: $t, termSource: $s); $s has name $source;\nselect $source, $term;";
  $query12 has storedPackage "lingo";
  $query12 has storedVersion "1.1.0";
  $query12 has storedQueryExplanation "Lists the terms marked as named by the reader because the source relied on an idea without giving it a name.";

put $query17 isa StoredQuery, has storedQueryName "lingo/what-the-brief-says-now";
update $query17 has storedQueryTitle "What the brief says now";
  $query17 has storedQueryText "match\n  $brief isa ModelingBrief, has briefId \"pom\";\n  let $revision = current_revision($brief);\n  inclusion (revision: $revision, element: $e);\n  $e isa! $kind, has containedText $statement;\nselect $kind, $statement;";
  $query17 has storedPackage "lingo";
  $query17 has storedVersion "1.1.0";
  $query17 has storedQueryExplanation "Finds the current revision of the brief and lists every statement in it with its kind: purpose, scope, concept, relation, constraint or question.";

put $query24 isa StoredQuery, has storedQueryName "lingo/session-and-transcript-of-a-reading";
update $query24 has storedQueryTitle "Session and transcript of a reading";
  $query24 has storedQueryText "match\n  $r isa Reading, has readingId $reading;\n  processRecord (record: $s, recordedReading: $r); $s has name $session;\n  whereabouts (locatedSource: $s, location: $l); $l has containedText $transcript;\nselect $reading, $session, $transcript;";
  $query24 has storedPackage "lingo";
  $query24 has storedVersion "1.1.0";
  $query24 has storedQueryExplanation "Shows, for each reading, the working session it was done in and where that session's transcript is kept.";

put $query25 isa StoredQuery, has storedQueryName "lingo/statements-resting-only-on-the-owner-s-word";
update $query25 has storedQueryTitle "Statements resting only on the owner's word";
  $query25 has storedQueryText "match\n  $brief isa ModelingBrief, has briefId \"pom\";\n  let $revision = current_revision($brief);\n  $e isa BriefElement, has containedText $statement;\n  inclusion (revision: $revision, element: $e);\n  grounding (element: $e, groundingClaim: $c);\n  support (supportedClaim: $c, evidence: $p); placement (passage: $p, passageSource: $session);\n  $session isa SessionRecord, has name $sessionName;\n  not {\n    grounding (element: $e, groundingClaim: $c2);\n    support (supportedClaim: $c2, evidence: $p2); placement (passage: $p2, passageSource: $s2);\n    not { $s2 isa SessionRecord; };\n  };\nselect $statement, $sessionName;\ndistinct;";
  $query25 has storedPackage "lingo";
  $query25 has storedVersion "1.1.0";
  $query25 has storedQueryExplanation "Lists statements in the current brief whose support comes only from what the owner said in a working session and from no published source.";

put $question25 isa StoredQuestion, has storedQuestionId "lingo/q-25";
update $question25 has storedQuestionText "Which statements in the brief rest only on what the owner said in a session, and on no published source?";
  $question25 has storedPackage "lingo";
  $question25 has storedVersion "1.1.0";
  $question25 has storedQuestionOrder 25;
put storedAnswer (question: $question25, query: $query25);
