transaction read lingo-redesign-scratch

match $b isa ModelingBrief, has briefId "pom"; let $c in concepts_without_question($b); $c has name $n; select $n;
end;

match let $t in unreconciled_terms(); $t has name $n; select $n;
end;

match $e isa BriefConcept, has name $n; not { grounding (element: $e); }; select $n;
end;

match $d isa Distinction, has containedText $text; aboutness (claim: $d, term: $t); $t has name $term; select $term, $text;
end;

match division (dividedTerm: $of, memberTerm: $m); $of has name $o; $m has name $member; select $o, $member;
end;

match $r isa Reading, has readingId $rid; processRecord (record: $s, recordedReading: $r); $s has name $session; whereabouts (locatedSource: $s, location: $l); $l has containedText $where; select $rid, $session, $where;
end;

match $e isa BriefElement, has containedText $n; grounding (element: $e, groundingClaim: $c);
  not { grounding (element: $e, groundingClaim: $c2); support (supportedClaim: $c2, evidence: $p2); placement (passage: $p2, passageSource: $s2); not { $s2 isa SessionRecord; }; };
  select $n;
end;

match $s isa EvidenceSource, has name $source; whereabouts (locatedSource: $s, location: $l); $l has containedText $where;
  locationClassification (classifiedLocation: $l, locationKind: $k); $k has name $kind;
  try { sourceFormat (formattedSource: $s, format: $f); $f has name $format; };
  select $source, $format, $kind, $where;
end;

match $r isa Reading, has readingId $rid; copyRead (readingOfCopy: $r, copy: $l); $l has containedText $copy; select $rid, $copy;
end;

close
