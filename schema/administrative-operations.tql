# manifest: manifests/lingo-v1.1.2.package-manifest.json
# generator: hand-authored-package-bootstrap/0.1.0
define

attribute installationKey, value string;
attribute installedAt, value string;

entity OntologyModuleInstallation sub Event,
    owns installationKey @key,
    owns installedAt,
    plays installationOfOntologyModuleVersion:installation;

relation installationOfOntologyModuleVersion sub isBasedOn,
    relates installation as derivedThing,
    relates version as basis;

OntologyModuleVersion plays installationOfOntologyModuleVersion:version;

# Optional install-record fields (gist 5.1.0). All optional, so records
# written before 5.1.0 stay valid. A failed install has no
# installationOfOntologyModuleVersion link, so the record names its package
# (installedModuleRepoUrl) and version (targetModuleVersion) itself.
attribute previousModuleVersion, value string;
attribute targetModuleVersion, value string;
attribute installedModuleRepoUrl, value string;
attribute installationTrigger, value string @values("install", "upgrade", "rebuild", "migration");
attribute installationOutcome, value string @values("succeeded", "failed");
attribute installationError, value string;

OntologyModuleInstallation owns previousModuleVersion @card(0..1),
    owns targetModuleVersion @card(0..1),
    owns installedModuleRepoUrl @card(0..1),
    owns installationTrigger @card(0..1),
    owns installationOutcome @card(0..1),
    owns installationError @card(0..1);
