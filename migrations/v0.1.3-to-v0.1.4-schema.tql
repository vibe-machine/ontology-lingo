define

attribute lingoCandidateId, value string;
attribute lingoSchemaLifecycleIntent, value string @values("add", "reuse", "noChange", "defer");

relation lingoPlanItemUsesEvidence,
  relates planItemRevision,
  relates evidence;

relation lingoPlanItemAffectedByConstraint,
  relates planItemRevision,
  relates constraintRevision;

relation lingoPlanItemAffectedByCompetencyQuestion,
  relates planItemRevision,
  relates questionRevision;

relation lingoPlanItemHasClarification,
  relates planItemRevision,
  relates clarificationIssue;

relation lingoPlanItemOverrides,
  relates newerItemRevision,
  relates olderItemRevision;

define
entity LingoEvidenceExcerpt plays lingoPlanItemUsesEvidence:evidence;

define
entity LingoBriefDomainConstraintRevision plays lingoPlanItemAffectedByConstraint:constraintRevision;

define
entity LingoBriefCompetencyQuestionRevision plays lingoPlanItemAffectedByCompetencyQuestion:questionRevision;

define
entity LingoGroundingPlanItemRevision owns lingoSchemaLifecycleIntent;

define
entity LingoGroundingPlanItemRevision plays lingoPlanItemUsesEvidence:planItemRevision;

define
entity LingoGroundingPlanItemRevision plays lingoPlanItemAffectedByConstraint:planItemRevision;

define
entity LingoGroundingPlanItemRevision plays lingoPlanItemAffectedByCompetencyQuestion:planItemRevision;

define
entity LingoGroundingPlanItemRevision plays lingoPlanItemHasClarification:planItemRevision;

define
entity LingoGroundingPlanItemRevision plays lingoPlanItemOverrides:newerItemRevision;

define
entity LingoGroundingPlanItemRevision plays lingoPlanItemOverrides:olderItemRevision;

define
entity LingoGroundingCandidate owns lingoCandidateId @key;

define
entity LingoClarificationIssue plays lingoPlanItemHasClarification:clarificationIssue;
