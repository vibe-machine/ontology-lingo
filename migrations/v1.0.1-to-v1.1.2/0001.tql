  $query3 has storedQueryText "match\n  $check isa ClaimCheck, has checkId $checkId;\n  checkSubject (check: $check, checkedClaim: $c); $c has claimId $claim, has containedText $text;\n  checkOutcome (judgedCheck: $check, verdict: $v); $v has name $verdict;\n  decisionMaking (decision: $check, decider: $who); $who has name $checker;\n  try { $check has description $note; };\nselect $claim, $text, $checker, $verdict, $note;";
