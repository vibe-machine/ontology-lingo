put $query1 isa StoredQuery, has storedQueryName "lingo/readings-for-a-subject";
update $query1 has storedQueryTitle "Readings for a subject";
  $query1 has storedQueryText "match\n  $brief isa ModelingBrief, has briefId \"pom\", has name $subject;\n  readingPurpose (purposefulReading: $r, purposeBrief: $brief);\n  $r has readingId $reading, has atDateTime $when, has formatVersion $briefVersion;\n  readingSubject (pass: $r, sourceRead: $s); $s has name $source;\n  readership (reading: $r, reader: $who);\n  try { $who has name $reader; };\nselect $subject, $source, $reading, $reader, $when, $briefVersion;";
  $query1 has storedPackage "lingo";
  $query1 has storedVersion "1.1.0";
  $query1 has storedQueryExplanation "Finds the readings done for one subject's brief (here the product operating model) and shows the source read, who read it, when, and which version of the reading brief they followed.";

put $question1 isa StoredQuestion, has storedQuestionId "lingo/q-01";
update $question1 has storedQuestionText "Which sources have been read for a subject, by whom, when, and under which version of the reading brief?";
  $question1 has storedPackage "lingo";
  $question1 has storedVersion "1.1.0";
  $question1 has storedQuestionOrder 1;
put storedAnswer (question: $question1, query: $query1);

put $query2 isa StoredQuery, has storedQueryName "lingo/passages-that-claims-rest-on";
update $query2 has storedQueryTitle "Passages that claims rest on";
  $query2 has storedQueryText "match\n  readingSubject (pass: $r, sourceRead: $s); $s has name $source;\n  try {\n    placement (passage: $p, passageSource: $s); $p has locator $passage;\n    support (supportedClaim: $c, evidence: $p);\n  };\nselect $source, $passage;\ndistinct;";
  $query2 has storedPackage "lingo";
  $query2 has storedVersion "1.1.0";
  $query2 has storedQueryExplanation "Lists every source that was read with the passages its claims point to. A source with an empty passage column had no claim resting on it, so it yielded nothing.";

put $question2 isa StoredQuestion, has storedQuestionId "lingo/q-02";
update $question2 has storedQuestionText "Which passages of a source does any claim rest on, and which sources yielded nothing?";
  $question2 has storedPackage "lingo";
  $question2 has storedVersion "1.1.0";
  $question2 has storedQuestionOrder 2;
put storedAnswer (question: $question2, query: $query2);

