define

LingoBriefElement
  plays lingoRelationFrameHasTemporalCommitment:temporalCommitmentElement,
  plays lingoCompetencyQuestionRefersToElement:referencedElement;

LingoBriefElementRevision
  plays lingoRelationFrameHasTemporalCommitment:frameRevision,
  plays lingoCompetencyQuestionRefersToElement:questionRevision;

relation lingoRelationFrameHasTemporalCommitment,
  relates frameRevision,
  relates temporalCommitmentElement;

relation lingoCompetencyQuestionRefersToElement,
  relates questionRevision,
  relates referencedElement;
