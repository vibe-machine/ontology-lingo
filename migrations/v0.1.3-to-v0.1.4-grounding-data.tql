match
  $item isa LingoGroundingPlanItemRevision,
    has lingoModelingAct $old,
    has lingoProposedTargetKind "entity";
  $old == "reuse";
  not { $item has lingoSchemaLifecycleIntent $_; };
delete
  has $old of $item;
insert
  $item has lingoModelingAct "categorize";
  $item has lingoSchemaLifecycleIntent "reuse";

match
  $item isa LingoGroundingPlanItemRevision,
    has lingoModelingAct $old,
    has lingoProposedTargetKind "relation";
  $old == "reuse";
  not { $item has lingoSchemaLifecycleIntent $_; };
delete
  has $old of $item;
insert
  $item has lingoModelingAct "compose";
  $item has lingoSchemaLifecycleIntent "reuse";

match
  $item isa LingoGroundingPlanItemRevision,
    has lingoModelingAct $old,
    has lingoProposedTargetKind "attribute";
  $old == "reuse";
  not { $item has lingoSchemaLifecycleIntent $_; };
delete
  has $old of $item;
insert
  $item has lingoModelingAct "specialize";
  $item has lingoSchemaLifecycleIntent "reuse";

match
  $item isa LingoGroundingPlanItemRevision, has lingoModelingAct $old;
  $old == "defer";
  not { $item has lingoSchemaLifecycleIntent $_; };
delete
  has $old of $item;
insert
  $item has lingoModelingAct "categorize";
  $item has lingoSchemaLifecycleIntent "defer";

match
  $item isa LingoGroundingPlanItemRevision, has lingoModelingAct $act;
  { $act == "specialize"; } or
  { $act == "compose"; } or
  { $act == "categorize"; };
  not { $item has lingoSchemaLifecycleIntent $_; };
insert
  $item has lingoSchemaLifecycleIntent "add";

match
  $item isa LingoGroundingPlanItemRevision, has lingoModelingAct "instantiate";
  not { $item has lingoSchemaLifecycleIntent $_; };
insert
  $item has lingoSchemaLifecycleIntent "noChange";
