# Additive Conceptual Model storage; no existing data or constraints are removed.
define
attribute lingoConceptualMigrationId, value string;
attribute lingoConceptualLifecycle, value string @values("proposed", "accepted");
attribute lingoConceptualMigrationState, value string @values("transformed", "requiresReview");
attribute lingoSourceModelingIntentRevisionId, value string;
attribute lingoSourceModelingIntentContentHash, value string;

entity LingoConceptualModelRevision sub LingoRevisionArtifact,
  owns lingoConceptualLifecycle,
  owns lingoSourceModelingIntentRevisionId,
  owns lingoSourceModelingIntentContentHash,
  plays lingoWorkbookHasConceptualModelRevision:conceptualModelRevision,
  plays lingoWorkbookCurrentConceptualModel:conceptualModelRevision,
  plays lingoConceptualModelIncludesDeclaration:conceptualModelRevision,
  plays lingoConceptualMigrationProduces:conceptualModelRevision;

entity LingoConceptualDeclarationRevision sub LingoRevisionArtifact,
  owns lingoElementKind,
  plays lingoConceptualModelIncludesDeclaration:declarationRevision;

entity LingoConceptTypeRevision sub LingoConceptualDeclarationRevision;
entity LingoConceptualRelationFrameRevision sub LingoConceptualDeclarationRevision;
entity LingoConceptualPropertyRevision sub LingoConceptualDeclarationRevision;
entity LingoConceptualConstraintRevision sub LingoConceptualDeclarationRevision;

entity LingoConceptualMigrationReport sub LingoArtifact,
  owns lingoConceptualMigrationId @key,
  owns lingoConceptualMigrationState,
  owns lingoContractVersion,
  owns lingoText,
  plays lingoWorkbookHasConceptualMigration:migrationReport,
  plays lingoConceptualMigrationUsesBrief:migrationReport,
  plays lingoConceptualMigrationProduces:migrationReport;

relation lingoWorkbookHasConceptualModelRevision,
  relates workbook,
  relates conceptualModelRevision;

relation lingoWorkbookCurrentConceptualModel,
  relates workbook,
  relates conceptualModelRevision;

relation lingoConceptualModelIncludesDeclaration,
  relates conceptualModelRevision,
  relates declarationRevision;

relation lingoWorkbookHasConceptualMigration,
  relates workbook,
  relates migrationReport;

relation lingoConceptualMigrationUsesBrief,
  relates migrationReport,
  relates briefRevision;

relation lingoConceptualMigrationProduces,
  relates migrationReport,
  relates conceptualModelRevision;

entity LingoStudioWorkbook,
  plays lingoWorkbookHasConceptualModelRevision:workbook,
  plays lingoWorkbookCurrentConceptualModel:workbook,
  plays lingoWorkbookHasConceptualMigration:workbook;

entity LingoModelingBriefRevision,
  plays lingoConceptualMigrationUsesBrief:briefRevision;
