match
  $workbook isa LingoStudioWorkbook, has lingoCreatedAt $created;
  not { $workbook has lingoUpdatedAt $_; };
let $createdValue = $created;
insert
  $workbook has lingoUpdatedAt == $createdValue;

match
  $canonical isa LingoStudioWorkbook, has lingoWorkbookId $canonicalId;
  $legacy isa LingoWorkbook, has workbookId $legacyId, has workbookIntent $intent;
  $canonicalId == $legacyId;
  not { $canonical has lingoIntent $_; };
let $intentValue = $intent;
insert
  $canonical has lingoIntent == $intentValue;
