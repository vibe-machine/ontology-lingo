# Sample data for the competency questions: the records the app loads into this package's sample
# database (sample-lingo) and that `ont check-questions` runs every question against.
# Queries are separated by lines reading `end;`; `ont prepare-package` (and `ont release`) write each
# one to sandbox/sample-data/NNNN.tql and list them in package.json `sampleData`. Edit this file only.

# Part 1: one book, one working session, a brief of two concepts.
# It is not package data and is never installed. The meanings are in our own words.
match
  $book isa SourceKind, has name "book";
  $stated isa EpistemicState, has name "stated";
  $asserted isa EpistemicState, has name "asserted";
  $measure isa ConceptKind, has name "measure";
  $thing isa ConceptKind, has name "thing";
  $central isa Weight, has name "central";
  $kinds isa ListKind, has name "kinds";
  $same isa TermFit, has name "same";
  $epub isa MediaType, has name "EPUB";
  $web isa LocationKind, has name "web address"; $file isa LocationKind, has name "local file";
  $sessionKind isa SourceKind, has name "session";
insert
  $opus isa AssistantModel, has name "claude-opus";
  $src isa EvidenceSource, has sourceId "cagan-transformed-2024", has name "Transformed", has authorName "Marty Cagan", has publishedYear 2024;
  sourceClassification (classifiedSource: $src, sourceKind: $book);
  sourceFormat (formattedSource: $src, format: $epub);
  $l1 isa SourceLocation, has containedText "books/transformed.epub"; whereabouts (locatedSource: $src, location: $l1); locationClassification (classifiedLocation: $l1, locationKind: $file);
  $l2 isa SourceLocation, has containedText "corpus/text/transformed.txt"; whereabouts (locatedSource: $src, location: $l2); locationClassification (classifiedLocation: $l2, locationKind: $file);
  $p1 isa Passage, has passageId "ct-1312", has locator "line 1312: Principle: Outcomes over Output";
  $p2 isa Passage, has passageId "ct-889", has locator "line 889: Product Managers, Product Designers, and Engineers";
  placement (passage: $p1, passageSource: $src);
  placement (passage: $p2, passageSource: $src);
  $read isa Reading, has readingId "ct-read-1", has atDateTime 2026-11-20T16:00:00, has formatVersion "0.1";
  readingSubject (pass: $read, sourceRead: $src);
  readership (reading: $read, reader: $opus);
  copyRead (readingOfCopy: $read, copy: $l2);
  $sess isa SessionRecord, has sourceId "session-2026-11-20", has name "Working session, 20 November 2026";
  $l3 isa SourceLocation, has containedText "transcripts/75b134bd.jsonl"; whereabouts (locatedSource: $sess, location: $l3); locationClassification (classifiedLocation: $l3, locationKind: $file);
  sourceClassification (classifiedSource: $sess, sourceKind: $sessionKind);
  processRecord (record: $sess, recordedReading: $read);
  $sp isa Passage, has passageId "sess-1", has locator "the owner's message on who the customer is";
  placement (passage: $sp, passageSource: $sess);
  $said isa Principle, has claimId "sess-c1", has containedText "The reader of this model is an executive with a head of product and a head of engineering reporting to them.";
  support (supportedClaim: $said, evidence: $sp); authorship (authoredClaim: $said, reading: $read);
  standing (subject: $said, state: $asserted);
  $outcome isa SourceTerm, has termId "ct:outcome", has name "outcome";
  $output isa SourceTerm, has termId "ct:output", has name "output";
  $risk isa SourceTerm, has termId "ct:product-risk", has name "product risk";
  $value isa SourceTerm, has termId "ct:value-risk", has name "value risk";
  $viab isa SourceTerm, has termId "ct:viability-risk", has name "viability risk";
  $usab isa SourceTerm, has termId "ct:usability-risk", has name "usability risk";
  $feas isa SourceTerm, has termId "ct:feasibility-risk", has name "feasibility risk";
  vocabulary (term: $outcome, termSource: $src); vocabulary (term: $output, termSource: $src);
  vocabulary (term: $risk, termSource: $src); vocabulary (term: $value, termSource: $src);
  vocabulary (term: $viab, termSource: $src); vocabulary (term: $usab, termSource: $src);
  vocabulary (term: $feas, termSource: $src);
  $def isa TermDefinition, has claimId "ct-c1", has containedText "A business result a team is held to, as opposed to a list of things to deliver.";
  support (supportedClaim: $def, evidence: $p1); authorship (authoredClaim: $def, reading: $read);
  standing (subject: $def, state: $stated); aboutness (claim: $def, term: $outcome);
  conceptClassification (classifiedDefinition: $def, conceptKind: $measure); emphasis (weighedDefinition: $def, weight: $central);
  $dis isa Distinction, has claimId "ct-c2", has containedText "Shipping features is output; only solved problems that produce business results count.";
  support (supportedClaim: $dis, evidence: $p1); authorship (authoredClaim: $dis, reading: $read);
  standing (subject: $dis, state: $stated); aboutness (claim: $dis, term: $outcome); aboutness (claim: $dis, term: $output);
  $enum isa Enumeration, has claimId "ct-c3", has containedText "Product risk divides into four kinds.", has listIsComplete true;
  support (supportedClaim: $enum, evidence: $p2); authorship (authoredClaim: $enum, reading: $read);
  standing (subject: $enum, state: $stated); listClassification (classifiedList: $enum, listKind: $kinds);
  division (list: $enum, dividedTerm: $risk, memberTerm: $value, memberTerm: $viab, memberTerm: $usab, memberTerm: $feas);
  $brief isa ModelingBrief, has briefId "pom", has name "Product operating model";
  $rev isa BriefRevision, has briefRevisionId "pom-r1", has sequence 1, has atDateTime 2026-11-20T17:00:00;
  revisionHistory (revision: $rev, brief: $brief);
  $c1 isa BriefConcept, has briefElementId "pom-outcome", has name "Outcome", has containedText "A measured result a team answers for.";
  $c2 isa BriefConcept, has briefElementId "pom-risk", has name "Product risk", has containedText "A way an idea can fail, assessed before it is built.";
  inclusion (element: $c1, revision: $rev); inclusion (element: $c2, revision: $rev);
  standing (subject: $c1, state: $asserted); standing (subject: $c2, state: $asserted);
  grounding (element: $c1, groundingClaim: $def); grounding (element: $c1, groundingClaim: $dis);
  $q isa BriefQuestion, has briefElementId "pom-q317", has containedText "Which results is each team responsible for, as opposed to a list of things to deliver?";
  inclusion (element: $q, revision: $rev); standing (subject: $q, state: $asserted);
  questionReference (question: $q, referencedElement: $c1);
  $pur isa BriefPurpose, has briefElementId "pom-purpose", has containedText "Answer an executive's questions about how the product company is run.";
  inclusion (element: $pur, revision: $rev); standing (subject: $pur, state: $asserted);
  grounding (element: $pur, groundingClaim: $said);
  $rec isa Reconciliation, has reconciliationId "rec-1", has atDateTime 2026-11-20T17:05:00, has description "The author's outcome is our Outcome.";
  termReconciliation (decision: $rec, term: $outcome, concept: $c1); fit (reconciliation: $rec, degree: $same);
  decisionMaking (decision: $rec, decider: $opus);
end;

# Part 2, loaded after part 1.
# It adds a second source that uses one word differently, a source that yielded nothing,
# one claim of each remaining kind, two checks, and a second revision of the brief.
# It is not package data and is never installed. All wording is our own, invented for the sample.
match
  $src isa EvidenceSource, has sourceId "cagan-transformed-2024";
  $read isa Reading, has readingId "ct-read-1";
  $opus isa AssistantModel, has name "claude-opus";
  $p1 isa Passage, has passageId "ct-1312";
  $p2 isa Passage, has passageId "ct-889";
  $def isa TermDefinition, has claimId "ct-c1";
  $enum isa Enumeration, has claimId "ct-c3";
  $said isa Principle, has claimId "sess-c1";
  $value isa SourceTerm, has termId "ct:value-risk";
  $brief isa ModelingBrief, has briefId "pom";
  $c1 isa BriefConcept, has briefElementId "pom-outcome";
  $c2 isa BriefConcept, has briefElementId "pom-risk";
  $q isa BriefQuestion, has briefElementId "pom-q317";
  $pur isa BriefPurpose, has briefElementId "pom-purpose";
  $essayKind isa SourceKind, has name "essay";
  $stated isa EpistemicState, has name "stated";
  $implied isa EpistemicState, has name "implied";
  $asserted isa EpistemicState, has name "asserted";
  $suggested isa EpistemicState, has name "suggested";
  $assumed isa EpistemicState, has name "assumed";
  $story isa ClaimOrigin, has name "story";
  $statement isa ClaimOrigin, has name "statement";
  $thing isa ConceptKind, has name "thing";
  $measure isa ConceptKind, has name "measure";
  $group isa ConceptKind, has name "group";
  $supporting isa Weight, has name "supporting";
  $should isa RuleStrength, has name "should";
  $answersFor isa DutyMode, has name "answers for";
  $confirmed isa CheckVerdict, has name "confirmed";
  $overstated isa CheckVerdict, has name "overstated";
  $different isa TermFit, has name "different";
  $html isa MediaType, has name "HTML";
  $markdown isa MediaType, has name "Markdown";
  $web isa LocationKind, has name "web address";
  $file isa LocationKind, has name "local file";
insert
  # The subject every reading was done for.
  readingPurpose (purposefulReading: $read, purposeBrief: $brief);

  # A second reader, who checks claims and decides reconciliations.
  $fable isa AssistantModel, has name "claude-fable";
  $chk1 isa ClaimCheck, has checkId "chk-1", has atDateTime 2026-11-20T18:00:00;
  checkSubject (check: $chk1, checkedClaim: $def); checkOutcome (judgedCheck: $chk1, verdict: $confirmed);
  decisionMaking (decision: $chk1, decider: $fable);
  $chk2 isa ClaimCheck, has checkId "chk-2", has atDateTime 2026-11-20T18:05:00,
    has description "The passage names four kinds but does not say there are no others.";
  checkSubject (check: $chk2, checkedClaim: $enum); checkOutcome (judgedCheck: $chk2, verdict: $overstated);
  decisionMaking (decision: $chk2, decider: $fable);

  # More terms and claims from the first source.
  $idea isa SourceTerm, has termId "ct:product-idea", has name "product idea";
  $proposed isa SourceTerm, has termId "ct:proposed", has name "proposed";
  $tested isa SourceTerm, has termId "ct:tested", has name "tested";
  $built isa SourceTerm, has termId "ct:built", has name "built";
  $pm isa SourceTerm, has termId "ct:product-manager", has name "product manager";
  $capacity isa SourceTerm, has termId "ct:discovery-capacity", has name "discovery capacity", has termIsReaders true;
  vocabulary (term: $idea, termSource: $src); vocabulary (term: $proposed, termSource: $src);
  vocabulary (term: $tested, termSource: $src); vocabulary (term: $built, termSource: $src);
  vocabulary (term: $pm, termSource: $src); vocabulary (term: $capacity, termSource: $src);

  $life isa LifeHistory, has claimId "ct-c4", has statesAreOrdered true,
    has containedText "In the story of one team, an idea is first proposed, then tested with users, and only then built.";
  support (supportedClaim: $life, evidence: $p2); authorship (authoredClaim: $life, reading: $read);
  standing (subject: $life, state: $implied); origin (originClaim: $life, originKind: $story);
  aboutness (claim: $life, term: $idea);
  $step1 isa step, links (history: $life, state: $proposed), has sequence 1;
  $step2 isa step, links (history: $life, state: $tested), has sequence 2;
  $step3 isa step, links (history: $life, state: $built), has sequence 3;

  $duty isa DutyClaim, has claimId "ct-c5", has containedText "The product manager answers for value risk.";
  support (supportedClaim: $duty, evidence: $p2); authorship (authoredClaim: $duty, reading: $read);
  standing (subject: $duty, state: $stated); origin (originClaim: $duty, originKind: $statement);
  dutyClassification (classifiedDuty: $duty, mode: $answersFor);
  duty (claim: $duty, actor: $pm, target: $value);
  aboutness (claim: $duty, term: $pm);

  $rule isa Rule, has claimId "ct-c6", has quantity 10.0, has quantityUnit "ideas a week",
    has containedText "A team should test many ideas a week; the sample figure is ten.";
  support (supportedClaim: $rule, evidence: $p1); authorship (authoredClaim: $rule, reading: $read);
  standing (subject: $rule, state: $implied); force (rule: $rule, strength: $should);
  aboutness (claim: $rule, term: $idea);

  $capdef isa TermDefinition, has claimId "ct-c7",
    has containedText "The time a team keeps free for trying ideas before building them.";
  support (supportedClaim: $capdef, evidence: $p1); authorship (authoredClaim: $capdef, reading: $read);
  standing (subject: $capdef, state: $implied); aboutness (claim: $capdef, term: $capacity);
  conceptClassification (classifiedDefinition: $capdef, conceptKind: $measure);

  # A second source, read later, that uses "outcome" for something else.
  $essay isa EvidenceSource, has sourceId "sample-essay-2025", has name "Teams and Their Work", has authorName "A. Sample", has publishedYear 2025;
  sourceClassification (classifiedSource: $essay, sourceKind: $essayKind);
  sourceFormat (formattedSource: $essay, format: $html);
  $el isa SourceLocation, has containedText "https://example.org/teams-and-their-work";
  whereabouts (locatedSource: $essay, location: $el); locationClassification (classifiedLocation: $el, locationKind: $web);
  $ep isa Passage, has passageId "se-4", has locator "paragraph 4";
  placement (passage: $ep, passageSource: $essay);
  $read2 isa Reading, has readingId "se-read-1", has atDateTime 2026-11-21T09:00:00, has formatVersion "0.1";
  readingSubject (pass: $read2, sourceRead: $essay); readership (reading: $read2, reader: $opus);
  copyRead (readingOfCopy: $read2, copy: $el);
  readingPurpose (purposefulReading: $read2, purposeBrief: $brief);
  $eOutcome isa SourceTerm, has termId "se:outcome", has name "outcome";
  $eTeam isa SourceTerm, has termId "se:team", has name "team";
  $eRoadmap isa SourceTerm, has termId "se:roadmap", has name "roadmap";
  vocabulary (term: $eOutcome, termSource: $essay); vocabulary (term: $eTeam, termSource: $essay);
  vocabulary (term: $eRoadmap, termSource: $essay);
  $edef isa TermDefinition, has claimId "se-c1", has containedText "Any finished piece of work a team can point to.";
  support (supportedClaim: $edef, evidence: $ep); authorship (authoredClaim: $edef, reading: $read2);
  standing (subject: $edef, state: $stated); aboutness (claim: $edef, term: $eOutcome);
  conceptClassification (classifiedDefinition: $edef, conceptKind: $thing); emphasis (weighedDefinition: $edef, weight: $supporting);
  $eteamdef isa TermDefinition, has claimId "se-c2", has containedText "A small, lasting group that owns one area of the product.";
  support (supportedClaim: $eteamdef, evidence: $ep); authorship (authoredClaim: $eteamdef, reading: $read2);
  standing (subject: $eteamdef, state: $stated); aboutness (claim: $eteamdef, term: $eTeam);
  conceptClassification (classifiedDefinition: $eteamdef, conceptKind: $group);
  $rec2 isa Reconciliation, has reconciliationId "rec-2", has atDateTime 2026-11-21T09:30:00,
    has description "The essay's outcome is a delivered thing, which our Outcome is not.";
  termReconciliation (decision: $rec2, term: $eOutcome, concept: $c1); fit (reconciliation: $rec2, degree: $different);
  decisionMaking (decision: $rec2, decider: $fable);

  # A source that was read and yielded nothing.
  $notes isa EvidenceSource, has sourceId "sample-notes-2024", has name "Notes on Roadmaps";
  sourceClassification (classifiedSource: $notes, sourceKind: $essayKind);
  sourceFormat (formattedSource: $notes, format: $markdown);
  $nl isa SourceLocation, has containedText "corpus/text/notes-on-roadmaps.md";
  whereabouts (locatedSource: $notes, location: $nl); locationClassification (classifiedLocation: $nl, locationKind: $file);
  $read3 isa Reading, has readingId "nr-read-1", has atDateTime 2026-11-19T10:00:00, has formatVersion "0.1";
  readingSubject (pass: $read3, sourceRead: $notes); readership (reading: $read3, reader: $fable);
  copyRead (readingOfCopy: $read3, copy: $nl);
  readingPurpose (purposefulReading: $read3, purposeBrief: $brief);

  # The brief's second revision: a new purpose replaces the old, and new statements join.
  $rev2 isa BriefRevision, has briefRevisionId "pom-r2", has sequence 2, has atDateTime 2026-11-21T10:00:00,
    has description "Purpose widened; team concept and a relation added.";
  revisionHistory (revision: $rev2, brief: $brief);
  decisionMaking (decision: $rev2, decider: $opus);
  $pur2 isa BriefPurpose, has briefElementId "pom-purpose-2",
    has containedText "Answer an executive's questions about how the product company is run and how that is changing.";
  replacement (newer: $pur2, older: $pur);
  standing (subject: $pur2, state: $asserted); grounding (element: $pur2, groundingClaim: $said);
  $scope isa BriefScope, has briefElementId "pom-scope", has containedText "Product teams and the results they answer for.";
  standing (subject: $scope, state: $asserted);
  $assume isa BriefAssumption, has briefElementId "pom-assume", has containedText "Every product team has one product manager.";
  standing (subject: $assume, state: $assumed);
  $constraint isa BriefConstraint, has briefElementId "pom-constraint", has containedText "A team answers for at least one outcome.";
  standing (subject: $constraint, state: $suggested);
  $c3 isa BriefConcept, has briefElementId "pom-team", has name "Team", has containedText "A lasting group that answers for results in one area.";
  standing (subject: $c3, state: $suggested);
  grounding (element: $c3, groundingClaim: $eteamdef); grounding (element: $c3, groundingClaim: $duty);
  $frame isa BriefRelationFrame, has briefElementId "pom-answers-for", has name "answers for",
    has containedText "A team answers for an outcome.";
  standing (subject: $frame, state: $suggested);
  $fe1 isa frameEnd, links (frame: $frame, participant: $c3), has name "responsible team";
  $fe2 isa frameEnd, links (frame: $frame, participant: $c1), has name "outcome answered for";
  $q2 isa BriefQuestion, has briefElementId "pom-q-open", has containedText "How is the company doing this quarter?";
  standing (subject: $q2, state: $suggested);
  inclusion (element: $c1, revision: $rev2); inclusion (element: $c2, revision: $rev2);
  inclusion (element: $q, revision: $rev2); inclusion (element: $pur2, revision: $rev2);
  inclusion (element: $scope, revision: $rev2); inclusion (element: $assume, revision: $rev2);
  inclusion (element: $constraint, revision: $rev2); inclusion (element: $c3, revision: $rev2);
  inclusion (element: $frame, revision: $rev2); inclusion (element: $q2, revision: $rev2);
end;
